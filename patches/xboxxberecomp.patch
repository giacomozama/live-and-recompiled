+    const float* o = argb;
+    switch (format) {
+        case 0x3A: case 0x3F: o = abgr; break;
+        case 0x3B: case 0x40: o = bgra; break;
+        case 0x3C: case 0x41: o = rgba; break;
+        default: break;
+    }
+    std::copy(o, o + 4, order);
